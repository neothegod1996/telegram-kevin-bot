# Copy to `.env` or `config.env` (config.env takes precedence if both exist).
# Never commit real secrets — `.env` and `config.env` are gitignored.

# --- Required (Telegram) ---
# From https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# From @BotFather
BOT_TOKEN=1234567890:AAExampleBotTokenReplaceMe

# Your Telegram numeric user ID (owner / operator)
OWNER_ID=123456789

# --- Required (database) ---
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=tg_bot

# --- Optional: log channels (bot must be admin; use channel ID, e.g. -1001234567890) ---
USER_INFO_LOG=0
FILES_LOG=0

# --- Optional: Notion backup/indexing ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Optional: behavior ---
# Seconds between pasted links in DM (rate-limit protection)
SLEEP_TIME=60
# Seconds after each batch item that actually saves to Telegram (not empty message IDs)
BATCH_SLEEP_TIME=3
# After crash/restart, resume in-progress batch tasks (ledger skips already-delivered posts)
BATCH_AUTO_RESUME_ON_START=false

# --- Optional: web login portal ---
# true / false / yes / no / 1 / 0
WEB_SERVER=False
# Public URL when deployed (Heroku, etc.); used for login links and keep-alive ping
WEB_URL=
# Set by PaaS (e.g. Heroku); local default is 8000
PORT=8000
# HMAC secret for login tokens; defaults to BOT_TOKEN if unset
LOGIN_PORTAL_SECRET=

# --- Optional: encrypt user session strings in MongoDB ---
# Required if existing sessions in DB were stored encrypted (enc:...)
SESSION_ENCRYPTION_KEY=
# Default: never unpack archives into server temporary storage for Notion.
NOTION_EXTRACT_ARCHIVES=false
